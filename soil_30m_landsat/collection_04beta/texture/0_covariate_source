// FUNÇÃO DE PREENCHIMENTO OTIMIZADA (SEM REPROJECT FORÇADO)
function preenche(img) {
  var vizinhos = img.focalMean(2, 'square', 'pixels', 3);
  return img.unmask(vizinhos);
}

// PROCESSAMENTO DE DADOS CONTÍNUOS DE CLIMA (OTIMIZADO)
function clima() {
  // Filtro espacial direto na fonte com .filterBounds(bounds) (Evita processar o mundo todo)
  var chirps = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
    .filterDate(CLIMA_INICIO, CLIMA_FIM)
    .filterBounds(bounds);
    
  var anos = ee.List.sequence(CLIMA_ANOS[0], CLIMA_ANOS[1]);

  var mediaDasSomas = function(meses) {
    return ee.ImageCollection.fromImages(anos.map(function(a) {
      var inicio = ee.Date.fromYMD(a, 1, 1);
      return chirps.filterDate(inicio, inicio.advance(1, 'year')).filter(meses).sum();
    })).mean();
  };
  
  var chuvaUmida = preenche(mediaDasSomas(MESES_UMIDOS)).rename('chirps_precip_wetQ_mm');
  var chuvaSeca = preenche(mediaDasSomas(MESES_SECOS)).rename('chirps_precip_dryQ_mm');

  var terraclimate = ee.ImageCollection('IDAHO_EPSCOR/TERRACLIMATE').filterBounds(bounds);
  var pdsi = terraclimate.filterDate(CLIMA_INICIO, CLIMA_FIM).select('pdsi').mean().multiply(0.01);
  var chuvaAnual = terraclimate.filterDate(NORMAL_INICIO, NORMAL_FIM).select('pr').sum().divide(30);

  var resultado = ee.Image.cat([
    chuvaUmida,
    chuvaSeca,
    preenche(pdsi).rename('terraclimate_pdsi_indiceSeca'),
    preenche(chuvaAnual).rename('terraclimate_pr_anual_mm')
  ]).round().clip(bounds);
  return resultado;
}
