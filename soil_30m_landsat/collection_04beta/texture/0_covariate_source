// TEMPERATURA DE SUPERFÍCIE (MODIS MOD11A2)
function temperatura() {
  var colecao = ee.ImageCollection('MODIS/061/MOD11A2')
    .filterDate(MODIS_INICIO, MODIS_FIM)
    .filterBounds(bounds);
  
  var lst = colecao.map(function(img) {
    return ee.Image(img.select(['LST_Day_1km', 'LST_Night_1km'], ['dia', 'noite'])
      .multiply(0.02).subtract(273.15)
      .copyProperties(img, ['system:time_start']));
  });
  
  var seca = lst.filter(MESES_SECOS).mean();
  var umida = lst.filter(MESES_UMIDOS).mean();
  var dia = seca.select('dia').subtract(umida.select('dia'));
  var noite = seca.select('noite').subtract(umida.select('noite'));

  var modisResultado = ee.Image.cat([
    preenche(dia).rename('modis_lst_day_seasAmp'),
    preenche(noite).rename('modis_lst_night_seasAmp')
  ]).round().clip(bounds);

  return modisResultado;
}
