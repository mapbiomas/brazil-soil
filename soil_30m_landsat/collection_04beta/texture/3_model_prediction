};

Map.addLayer(areiaFinal, {}, 'Areia - full stack [insp]', false);
Map.addLayer(silteFinal, {}, 'Silte - full stack [insp]', false);
Map.addLayer(argilaFinal, {}, 'Argila - full stack [insp]', false);
