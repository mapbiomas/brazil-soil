Map.addLayer(areiaFinal.select(0), PSD.areia, 'Areia 000_010cm (%) [vis]', true);
Map.addLayer(silteFinal.select(0), PSD.silte, 'Silte 000_010cm (%) [vis]', false);
Map.addLayer(argilaFinal.select(0), PSD.argila, 'Argila 000_010cm (%) [vis]', false);
Map.addLayer(esqueletoFinal.select(0), PSD.esqueleto, 'Esqueleto 000_010cm (g/kg) [vis]', false);

// -----------------------------------------------------------
// EXPORTAÇÃO PARA ASSET (COLEÇÃO 4)
// -----------------------------------------------------------
var export_base_path = 'projects/mapbiomas-brazil/assets/SOIL/RESULTS/collection4/psd/mbsoil_psd_c04_2026_11_23_test_a';

