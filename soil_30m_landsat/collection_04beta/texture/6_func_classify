var triangleRules = require('users/taciaraz/mapbiomas_solo:collection4/psd/6_define_triangle');

// Helper para padronizar as bandas de entrada para ('sand', 'silt', 'clay')
function prepareBands(img, bandNames) {
  return img.select(
    [bandNames.sand, bandNames.silt, bandNames.clay],
    ['sand', 'silt', 'clay']
  );
}

// 1. Grupamentos texturais (Legenda 1) — MIN: 0, MAX: 6
exports.classify_grup = function(img, bandNames, outName) {
  var standardized = prepareBands(img, bandNames);
  return triangleRules.l1_grupamentos_texturais(standardized)
    .rename(outName)
    .int8();
};

// 2. Sub-grupamentos texturais (Legenda 2) — MIN: 0, MAX: 9
exports.classify_subgrup = function(img, bandNames, outName) {
  var standardized = prepareBands(img, bandNames);
  return triangleRules.l2_subgrupamentos_texturais(standardized)
    .rename(outName)
    .int8();
};

// 3. Classes texturais (Legenda 3) — MIN: 0, MAX: 14
exports.classify_textural_group = function(img, bandNames, outName) {
  var standardized = prepareBands(img, bandNames);
  return triangleRules.l3_classes_texturais(standardized)
    .rename(outName)
    .int8();
};
