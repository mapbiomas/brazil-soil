// ============================================================================

Export.image.toAsset({
  image: spatialReliability,
  description: 'MapBiomas_Solo_C4_PSD_Spatial_Reliability_Asset',
  assetId: 'projects/mapbiomas-brazil/assets/SOIL/_PRODUCTS_C4/mapbiomas_soil_collection4_psd_distance_to_nearest_sample',
